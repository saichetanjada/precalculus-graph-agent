{
  "name": "precalculus-graph-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An AI precalculus tutor with verified graphing tools.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
